{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "react-perf", "jsx-a11y", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off"
  },
  "ignorePatterns": [
    "out/**",
    "build/**",
    "release/**",
    "dist/**",
    "coverage/**",
    "electron.vite.config.ts.timestamp-*"
  ],
  "overrides": [
    {
      "files": ["tests/**/*.ts", "**/*.test.ts", "**/*.test.tsx"],
      "env": { "vitest": true },
      "rules": {
        "vitest/no-conditional-expect": "off"
      }
    }
  ]
}
